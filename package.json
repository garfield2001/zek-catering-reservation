{
    "name": "zek-catering-reservation",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint resources/js",
        "format": "prettier --write resources/js resources/css *.json vite.config.ts eslint.config.js playwright.config.ts tests/Browser/*.ts",
        "format:check": "prettier --check resources/js resources/css *.json vite.config.ts eslint.config.js playwright.config.ts tests/Browser/*.ts",
        "test": "vitest run",
        "e2e": "playwright test"
    },
    "dependencies": {
        "@inertiajs/react": "^2.0.0",
        "lucide-react": "^1.55.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "@playwright/test": "^1.64.0",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^6.0.0",
        "@testing-library/react": "^16.0.0",
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.0.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^16.0.0",
        "jsdom": "^26.0.0",
        "laravel-vite-plugin": "^3.2.0",
        "prettier": "^3.0.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.4",
        "vitest": "^5.0.3"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
