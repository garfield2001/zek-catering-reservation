<diagram id="pencil-bookings" name="13 Pencil Bookings and Internal Requests"><mxGraphModel dx="1800" dy="1050" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1050"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="pb-booking" value="&lt;b&gt;PENCIL_BOOKINGS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;id PK; idempotency_key UUID UNIQUE&lt;br/&gt;status: active / closed / did_not_proceed / converted&lt;br/&gt;customer contact; tentative event/follow-up facts&lt;br/&gt;created_by; updated_by FK â†’ Users&lt;br/&gt;converted_reservation_request_id? UNIQUE FK&lt;br/&gt;converted_at?&lt;br/&gt;CHECK contact + status/conversion pairing&lt;br/&gt;Does NOT hold capacity" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=15;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="520" height="360" as="geometry"/></mxCell>
<mxCell id="pb-events" value="&lt;b&gt;PENCIL_BOOKING_EVENTS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;id PK; pencil_booking_id FK&lt;br/&gt;event_type; non-sensitive details JSONB&lt;br/&gt;actor_id? FK â†’ Users; created_at&lt;br/&gt;INDEX(booking_id, id)&lt;br/&gt;PostgreSQL UPDATE/DELETE guard&lt;br/&gt;APPEND ONLY lifecycle chronology" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=15;fillColor=#f8fafc;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="480" height="290" as="geometry"/></mxCell>
<mxCell id="pb-request" value="&lt;b&gt;RESERVATION_REQUESTS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;origin: public / manual / pencil_booking&lt;br/&gt;pencil_booking_id? UNIQUE FK&lt;br/&gt;created_by? FK â†’ Users&lt;br/&gt;Existing immutable request lines/snapshots&lt;br/&gt;CHECK aligns origin with actor/booking links&lt;br/&gt;Public access-code behavior unchanged" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=15;fillColor=#ecfdf5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="1320" y="90" width="430" height="310" as="geometry"/></mxCell>
<mxCell id="pb-catalog" value="&lt;b&gt;PUBLISHED CATALOG&lt;/b&gt;&lt;br/&gt;Main package required; add-on package/listing optional&lt;br/&gt;Live availability, selection, quantity and price revalidated&lt;br/&gt;Snapshot stored by the existing request engine" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=15;fillColor=#fefce8;strokeColor=#ca8a04;" vertex="1" parent="1"><mxGeometry x="1320" y="560" width="430" height="210" as="geometry"/></mxCell>
<mxCell id="pb-audit" value="&lt;b&gt;AUDIT_EVENTS / USERS&lt;/b&gt;&lt;br/&gt;security-relevant create/update/close/conversion audit&lt;br/&gt;separate from lifecycle chronology&lt;br/&gt;permissions: pencil_booking.view/manage + reservation_request.manage" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=15;fillColor=#fefce8;strokeColor=#ca8a04;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="520" height="190" as="geometry"/></mxCell>
<mxCell id="pb-e1" value="pencil_booking_id (0..1 : 1)" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERone;endArrow=ERmany;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pb-events" target="pb-booking"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="pb-e2" value="converted request / provenance (1 : 0..1)" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERone;endArrow=ERone;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pb-booking" target="pb-request"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="pb-e3" value="published selections → immutable snapshot" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERone;endArrow=ERmany;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pb-request" target="pb-catalog"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="pb-e4" value="actors and audit" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmany;endArrow=ERone;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pb-booking" target="pb-audit"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="pb-note" value="Conversion is one transaction: lock active booking → validate/reprice published selections through the normal request engine → persist request snapshots/provenance → mark booking converted → append lifecycle/audit events. Retried or concurrent conversion returns the existing linked request. No quotation, payment, capacity hold or confirmed reservation is created." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=15;fontSize=15;fillColor=#fff7ed;strokeColor=#c2410c;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="1690" height="110" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="payment-instruction-history" name="17 Payment Instruction History"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1"/>
<mxCell id="pi-policy" value="&lt;b&gt;BUSINESS_POLICIES&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;id PK; key=current&lt;br/&gt;current_payment_instruction_version_id FK NOT NULL&lt;br/&gt;Current approved instruction projection&lt;br/&gt;Administrator-only updates" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=15;fillColor=#eff6ff;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="500" height="260" as="geometry"/></mxCell>
<mxCell id="pi-version" value="&lt;b&gt;PAYMENT_INSTRUCTION_VERSIONS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;id PK; business_policy_id FK&lt;br/&gt;version_number UNIQUE per policy&lt;br/&gt;account / e-wallet / bank / instructions&lt;br/&gt;effective_at; created_by? FK&lt;br/&gt;INSERT ONLY PostgreSQL history guard" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=15;fillColor=#ecfdf5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="530" height="280" as="geometry"/></mxCell>
<mxCell id="pi-quote" value="&lt;b&gt;QUOTATION_VERSIONS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;terms_snapshot JSON includes the instruction snapshot at issuance&lt;br/&gt;Issued facts are immutable&lt;br/&gt;Track shows current instructions and flags later changes" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=15;fillColor=#fefce8;strokeColor=#ca8a04;" vertex="1" parent="1"><mxGeometry x="1330" y="90" width="410" height="240" as="geometry"/></mxCell>
<mxCell id="pi-request" value="&lt;b&gt;RESERVATION_REQUESTS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;emergency_booking_exception&lt;br/&gt;reason; authorized_by FK&lt;br/&gt;policy snapshot JSON&lt;br/&gt;All exception facts must exist together and are immutable&lt;br/&gt;No capacity/payment/acceptance side effect" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=15;fillColor=#fff7ed;strokeColor=#c2410c;" vertex="1" parent="1"><mxGeometry x="700" y="560" width="530" height="260" as="geometry"/></mxCell>
<mxCell id="pi-e1" value="history (1 : many)" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERone;endArrow=ERmany;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pi-policy" target="pi-version"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="pi-e2" value="issuance snapshot" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmany;endArrow=ERone;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pi-version" target="pi-quote"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
