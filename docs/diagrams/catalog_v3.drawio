<mxCell id="w-e9" value="group_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERone;startArrow=ERmany;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="w-rules" target="w-groups"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="w-e10" value="offering_option_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERone;startArrow=ERmany;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="w-options" target="w-serving"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="w-note" value="Implemented clean baseline: Collection → Package Product → Package Version. No Variant layer and no separate configuration table. The shared category menu supports Catering, configurable add-ons, packs and fixed bundles. Purchase quantities are version-owned, never inherited from a Collection. Optional per-food serving defaults and overrides are shown on page 04. Advanced add-on serving-option rules remain internal, not an ordinary editor. Publication locks the Package Product then Version; child guards lock the Version and forbid reparenting. Future modules on other pages are specification only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="60" y="1570" width="1860" height="150" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="catalog-v3-3" name="03 Individual Listings"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1500"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="l-family" value="&lt;b&gt;PRODUCT_FAMILIES&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;id PK&lt;br/&gt;is_addon=true; behavior_type=direct_sale&lt;br/&gt;active; archived_at?&lt;br/&gt;Editable name never selects business behavior" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="490" height="210" as="geometry"/></mxCell>
<mxCell id="l-food" value="&lt;b&gt;DISHES / CATEGORY&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;dishes.id PK; category_id FK&lt;br/&gt;Canonical food, globally available&lt;br/&gt;Live category/food/service availability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="650" y="40" width="490" height="210" as="geometry"/></mxCell>
