<mxCell id="rc-payment" value="&lt;b&gt;PAYMENT_ALLOCATIONS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;verified payment allocation history&lt;br/&gt;explicit reallocation only&lt;br/&gt;never automatic on change approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1240" y="490" width="480" height="180" as="geometry"/></mxCell>
<mxCell id="rc-e1" value="reservation_id" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmany;endArrow=ERone;" edge="1" parent="1" source="rc-change" target="rc-reservation"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="rc-e2" value="change_request_id" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmany;endArrow=ERone;" edge="1" parent="1" source="rc-events" target="rc-change"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="rc-e3" value="optional revision Version" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmany;endArrow=ERone;" edge="1" parent="1" source="rc-change" target="rc-quote"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="rc-note" value="Apply/re-confirm locks source and target Asia/Manila date-capacity keys in sorted order, repeats verified-payment and capacity checks, and keeps the prior confirmed reservation untouched on failure. The event histories complement Audit Events." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=14;fontSize=15;fillColor=#fefce8;strokeColor=#ca8a04;" vertex="1" parent="1"><mxGeometry x="60" y="820" width="1660" height="110" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
