<mxCell id="w-e9" value="group_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERone;startArrow=ERmany;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="w-rules" target="w-groups"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="w-e10" value="offering_option_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERone;startArrow=ERmany;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="w-options" target="w-serving"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="w-note" value="Implemented clean baseline: Collection → Package Product → Package Version. No Variant layer and no separate configuration table. The shared category menu supports Catering, configurable add-ons, packs and fixed bundles. Purchase quantities are version-owned, never inherited from a Collection. Optional per-food serving defaults and overrides are shown on page 04. Advanced add-on serving-option rules remain internal, not an ordinary editor. Publication locks the Package Product then Version; child guards lock the Version and forbid reparenting. Future modules on other pages are specification only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;fontSize=16;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="60" y="1570" width="1860" height="150" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="catalog-v3-3" name="03 Individual Listings"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1500"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="l-family" value="&lt;b&gt;PRODUCT_FAMILIES&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;id PK&lt;br/&gt;is_addon=true; behavior_type=direct_sale&lt;br/&gt;active; archived_at?&lt;br/&gt;Editable name never selects business behavior" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="490" height="210" as="geometry"/></mxCell>
<mxCell id="l-food" value="&lt;b&gt;DISHES / CATEGORY&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;dishes.id PK; category_id FK&lt;br/&gt;Canonical food, globally available&lt;br/&gt;Live category/food/service availability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="650" y="40" width="490" height="210" as="geometry"/></mxCell>
<mxCell id="l-option" value="&lt;b&gt;OFFERING_OPTIONS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;id PK; offering_id FK&lt;br/&gt;Optional listing source size&lt;br/&gt;Offering must match listing food + service&lt;br/&gt;Current offering/option availability checked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1220" y="40" width="490" height="210" as="geometry"/></mxCell>
<mxCell id="l-listing" value="&lt;b&gt;INDIVIDUAL_LISTINGS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;id PK; family_id FK; dish_id FK&lt;br/&gt;offering_option_id? FK&lt;br/&gt;code UNIQUE; creation_token UUID UNIQUE&lt;br/&gt;creation_hash CHAR(64)&lt;br/&gt;active; archived_at?; timestamps&lt;br/&gt;current_version_id? composite same-owner FK&lt;br/&gt;Source identity immutable; archived cannot restore&lt;br/&gt;Index(family_id,archived_at,active)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="490" height="420" as="geometry"/></mxCell>
<mxCell id="l-version" value="&lt;b&gt;LISTING_VERSIONS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;id PK; listing_id FK&lt;br/&gt;version_number; draft_revision &gt; 0&lt;br/&gt;status draft / published / abandoned&lt;br/&gt;name; uses_food_name; description?; selling_unit&lt;br/&gt;has_selling_options; price_minor BIGINT ≥ 0; currency PHP&lt;br/&gt;minimum_quantity; quantity_step &gt; 0&lt;br/&gt;maximum_quantity? ≥ minimum&lt;br/&gt;published_snapshot? JSONB&lt;br/&gt;published_at?; published_by? FK users&lt;br/&gt;cloned_from_id? FK same-owner older publication&lt;br/&gt;UNIQUE(listing_id,version_number); UNIQUE(id,listing_id)&lt;br/&gt;One Draft per listing (partial UNIQUE)&lt;br/&gt;Published requires positive price + snapshot + author/date&lt;br/&gt;Grouped: derived lowest price; snapshot schema 2&lt;br/&gt;Published/Abandoned rows immutable; no history deletion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="650" y="410" width="620" height="610" as="geometry"/></mxCell>
<mxCell id="l-selling-options" value="&lt;b&gt;LISTING_SELLING_OPTIONS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;id PK; listing_version_id FK RESTRICT&lt;br/&gt;label; price_minor BIGINT &gt;= 0&lt;br/&gt;sort_order &gt;= 0&lt;br/&gt;UNIQUE(version, normalized label)&lt;br/&gt;UNIQUE(version, sort_order)&lt;br/&gt;Draft-only edits; immutable ownership&lt;br/&gt;Deferred: grouped parent has 1+ options&lt;br/&gt;Parent price = minimum option price&lt;br/&gt;Published options all positive&lt;br/&gt;Legacy single-price parent has 0 options" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1340" y="710" width="400" height="390" as="geometry"/></mxCell>
<mxCell id="l-selling-options-fk" value="listing_version_id" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#64748b;" edge="1" parent="1" source="l-selling-options" target="l-version"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="l-user" value="&lt;b&gt;USERS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;id PK&lt;br/&gt;Predefined listing.* permissions&lt;br/&gt;Separate view/manage/price/publish/history/lifecycle&lt;br/&gt;No default Staff publication grants&lt;br/&gt;Mutations append Audit Events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1340" y="410" width="400" height="260" as="geometry"/></mxCell>
<mxCell id="l-e1" value="family_id" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#64748b;" edge="1" parent="1" source="l-listing" target="l-family"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="l-e2" value="dish_id" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#64748b;" edge="1" parent="1" source="l-listing" target="l-food"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="l-e3" value="offering_option_id?" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#64748b;" edge="1" parent="1" source="l-listing" target="l-option"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="l-e4" value="listing_id" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#64748b;" edge="1" parent="1" source="l-version" target="l-listing"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="l-e5" value="(current_version_id,id) → (id,listing_id)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#64748b;" edge="1" parent="1" source="l-listing" target="l-version"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="l-e6" value="published_by" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#64748b;" edge="1" parent="1" source="l-version" target="l-user"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="l-note" value="&lt;b&gt;Publication and availability&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Row locking serializes publish/clone; current pointer can only move forward.&lt;br/&gt;Frozen snapshot: names, food/category, serving size/capacity, unit price and purchase rules.&lt;br/&gt;One food listing has version-owned absolute-price selling options. Legacy single-price publications remain unchanged. Listings require no Package Product.&lt;br/&gt;Availability remains live; customer inquiries/checkout and storefront taxonomy are deferred." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="1700" height="210" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="catalog-serving-sizes" name="04 Package Serving Defaults and Sizes"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1300"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="s-version" value="&lt;b&gt;PACKAGE_VERSIONS&lt;/b&gt;&lt;br/&gt;id PK&lt;br/&gt;default_serving_quantity? NUMERIC(12,3)&lt;br/&gt;default_serving_unit_id? FK&lt;br/&gt;default_serving_size_label? VARCHAR(100)&lt;br/&gt;All empty OR positive quantity + unit&lt;br/&gt;Not permitted for Main Catering&lt;br/&gt;Published configuration immutable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="50" y="60" width="480" height="280" as="geometry"/></mxCell>
<mxCell id="s-unit" value="&lt;b&gt;MEASUREMENT_UNITS&lt;/b&gt;&lt;br/&gt;id PK; name; abbreviation; active&lt;br/&gt;Unique lower(trim(name)) and abbreviation&lt;br/&gt;Referenced units cannot be deleted&lt;br/&gt;Current active status governs new configuration&lt;br/&gt;Names and abbreviations frozen in publication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="680" y="60" width="480" height="250" as="geometry"/></mxCell>
<mxCell id="s-menu" value="&lt;b&gt;PACKAGE_VERSION_FOOD_ITEMS&lt;/b&gt;&lt;br/&gt;(package_version_id,dish_id) PK/FK&lt;br/&gt;Canonical food membership for this version&lt;br/&gt;Without explicit serving, inherits version default&lt;br/&gt;Food counts remain independent of sizes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="50" y="490" width="480" height="230" as="geometry"/></mxCell>
<mxCell id="s-group" value="&lt;b&gt;PACKAGE_FOOD_SIZE_GROUPS&lt;/b&gt;&lt;br/&gt;id PK; package_version_id FK; dish_id FK&lt;br/&gt;measurement_unit_id FK&lt;br/&gt;UNIQUE(package_version_id,dish_id)&lt;br/&gt;Composite FK to version food membership&lt;br/&gt;Immutable ownership; Draft edits only&lt;br/&gt;Explicit size group overrides package default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="680" y="490" width="480" height="280" as="geometry"/></mxCell>
<mxCell id="s-choice" value="&lt;b&gt;PACKAGE_FOOD_SIZE_CHOICES&lt;/b&gt;&lt;br/&gt;id PK; size_group_id FK&lt;br/&gt;quantity NUMERIC(12,3) positive&lt;br/&gt;size_label? VARCHAR(100)&lt;br/&gt;extra_price_minor BIGINT nonnegative&lt;br/&gt;is_default; exactly one default (deferred guard)&lt;br/&gt;Default has zero extra price&lt;br/&gt;Numeric quantity unique when label NULL&lt;br/&gt;Named lower(trim(label)) unique when present&lt;br/&gt;Immutable ownership; Published children immutable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1260" y="490" width="480" height="380" as="geometry"/></mxCell>
<mxCell id="s-e1" value="default_serving_unit_id (optional)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;fontSize=12;" edge="1" parent="1" source="s-version" target="s-unit"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s-e2" value="package_version_id" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;fontSize=12;" edge="1" parent="1" source="s-menu" target="s-version"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s-e3" value="(package_version_id,dish_id)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;fontSize=12;" edge="1" parent="1" source="s-group" target="s-menu"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s-e4" value="measurement_unit_id" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;fontSize=12;" edge="1" parent="1" source="s-group" target="s-unit"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s-e5" value="size_group_id" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;fontSize=12;" edge="1" parent="1" source="s-choice" target="s-group"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="s-note" value="Serving inheritance is package-version scoped, never Collection scoped. Package purchase quantity is distinct from each food amount. Named choices may share the same numeric amount. Exactly one choice per selected food; extras multiply purchased sets/packs. Snapshot schema 4 freezes defaults, unit labels, named choices and prices. Cloning copies these facts into a new Draft; historic snapshots are never rewritten." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="50" y="1010" width="1690" height="170" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="catalog-v3-5" name="05 Food Images"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1500"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="m-dish" value="&lt;b&gt;DISHES image metadata&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;id PK&lt;br/&gt;image_disk?&lt;br/&gt;image_path?; image_thumbnail_path?&lt;br/&gt;image_width?; image_height?&lt;br/&gt;CHECK all NULL or all non-NULL with positive dimensions&lt;br/&gt;Paths hidden from model JSON; controlled image URLs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="650" height="330" as="geometry"/></mxCell>
<mxCell id="m-store" value="&lt;b&gt;Laravel public disk (filesystem)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Public new photos; testing/public isolated; legacy private catalog references retained&lt;br/&gt;Generated ULID .jpg names; no client paths&lt;br/&gt;Decoded JPEG/PNG/WebP, ≤5 MB and ≤3000×3000&lt;br/&gt;Re-encoded JPEG full image ≤1600px, thumbnail ≤360px&lt;br/&gt;Failed/ancestor rollback removes new files&lt;br/&gt;Replaced/removed files deleted after commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="940" y="80" width="650" height="330" as="geometry"/></mxCell>
<mxCell id="m-e1" value="disk + generated paths" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#64748b;" edge="1" parent="1" source="m-dish" target="m-store"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="m-note" value="&lt;b&gt;Presentation, not frozen commercial facts&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Optional single image per Food Item; listings inherit current image.&lt;br/&gt;Authorized catalog users can inspect inactive images. Public reads require active food/category/service eligibility.&lt;br/&gt;Broken/missing images fall back to name-derived initials. Radix viewer supports Escape and focus restoration.&lt;br/&gt;No binary database fields, paid storage, multi-image attachment entities or asynchronous media pipeline.&lt;br/&gt;Storage cleanup failure is logged generically for operator follow-up; process crashes can require orphan cleanup." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="1530" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="catalog-v3-6" name="06 Access and Audit"><mxGraphModel dx="2400" dy="1457" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1457"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p5-n0" value="&lt;b&gt;USERS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;id PK&lt;br/&gt;email UNIQUE lower(email)&lt;br/&gt;password&lt;br/&gt;name&lt;br/&gt;active&lt;br/&gt;access_version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=17;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="650" height="224" as="geometry"/></mxCell>
<mxCell id="p5-n1" value="&lt;b&gt;ROLES&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;id PK&lt;br/&gt;code UNIQUE&lt;br/&gt;name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=17;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="650" height="149" as="geometry"/></mxCell>
<mxCell id="p5-n2" value="&lt;b&gt;PERMISSIONS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;id PK&lt;br/&gt;code UNIQUE&lt;br/&gt;description" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=17;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1580" y="110" width="650" height="149" as="geometry"/></mxCell>
<mxCell id="p5-n3" value="&lt;b&gt;USER_ROLES&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;user_id PK/FK&lt;br/&gt;role_id PK/FK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=17;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="474" width="650" height="124" as="geometry"/></mxCell>
<mxCell id="p5-n4" value="&lt;b&gt;ROLE_PERMISSIONS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;role_id PK/FK&lt;br/&gt;permission_id PK/FK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=17;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="820" y="474" width="650" height="124" as="geometry"/></mxCell>
<mxCell id="p5-n5" value="&lt;b&gt;USER_PERMISSION_OVERRIDES&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;user_id PK/FK&lt;br/&gt;permission_id PK/FK&lt;br/&gt;effect allow/deny" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=17;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1580" y="474" width="650" height="149" as="geometry"/></mxCell>
<mxCell id="p5-n6" value="&lt;b&gt;AUDIT_EVENTS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;id PK&lt;br/&gt;actor_id? FK&lt;br/&gt;actor_label&lt;br/&gt;action&lt;br/&gt;subject_type&lt;br/&gt;subject_id? historical locator&lt;br/&gt;before_data? JSONB&lt;br/&gt;after_data? JSONB&lt;br/&gt;request_id?&lt;br/&gt;context JSONB redacted&lt;br/&gt;created_at&lt;br/&gt;APPEND ONLY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=17;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="763" width="650" height="374" as="geometry"/></mxCell>
<mxCell id="p5-e0" value="user_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#64748b;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-n3" target="p5-n0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p5-e1" value="role_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#64748b;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-n3" target="p5-n1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p5-e2" value="role_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#64748b;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-n4" target="p5-n1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p5-e3" value="permission_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#64748b;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-n4" target="p5-n2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p5-e4" value="user_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#64748b;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-n5" target="p5-n0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p5-e5" value="permission_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#64748b;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-n5" target="p5-n2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p5-e6" value="actor_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#64748b;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-n6" target="p5-n0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="p5-note" value="Deny inactive users first; active Admin has full permission access within business invariants. Staff: explicit deny &gt; explicit allow &gt; role grant &gt; deny. Staff publishing/access administration OFF by default. Audit subjects are intentional historical locators, not business FKs. Protect last Admin; revoke stale access. Implemented access/audit baseline; full definitions: docs/05-database-entities.md. Environment execution is reported separately." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#eab308;fontSize=17;align=left;spacing=15;" vertex="1" parent="1"><mxGeometry x="60" y="1277" width="2170" height="135" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="catalog-presentation" name="07 Package Format and Presentation"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="pr-version" value="PACKAGE_VERSIONS (existing)&lt;br&gt;id PK&lt;br&gt;package_format? separate_servings / combined_contents&lt;br&gt;presentation_quantity? positive integer&lt;br&gt;presentation_unit_id? FK&lt;br&gt;Combined: exactly one container; uniform selections&lt;br&gt;Main Catering prohibited; Published immutable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;align=left;spacing=15;fontSize=16;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="590" height="250" as="geometry"/></mxCell>
<mxCell id="pr-food" value="PACKAGE_VERSION_FOOD_ITEMS (existing)&lt;br&gt;package_version_id + dish_id PK/FK&lt;br&gt;presentation_quantity? positive integer&lt;br&gt;presentation_unit_id? FK&lt;br&gt;Optional override only for separate_servings&lt;br&gt;Existing serving amounts and premiums remain independent&lt;br&gt;Published children immutable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;align=left;spacing=15;fontSize=16;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="590" height="250" as="geometry"/></mxCell>
<mxCell id="pr-unit" value="MEASUREMENT_UNITS (existing)&lt;br&gt;id PK; name; abbreviation; active&lt;br&gt;Restrictive deletion; referencing columns indexed&lt;br&gt;Labels frozen in schema-5 snapshots&lt;br&gt;No packaging inventory or automatic unit conversion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;align=left;spacing=15;fontSize=16;" vertex="1" parent="1"><mxGeometry x="950" y="240" width="480" height="230" as="geometry"/></mxCell>
<mxCell id="pr-e1" value="presentation_unit_id (optional)" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmany;endArrow=ERone;" edge="1" parent="1" source="pr-version" target="pr-unit"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="pr-e2" value="presentation_unit_id (optional)" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmany;endArrow=ERone;" edge="1" parent="1" source="pr-food" target="pr-unit"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="pr-e3" value="package_version_id" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmany;endArrow=ERone;" edge="1" parent="1" source="pr-food" target="pr-version"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="pr-note" value="Historical migration 000020 retained version-owned presentation without backfill. Migration 000022 (page 08) now supplies service defaults to new packages; resolved version facts remain frozen. Null legacy format means not recorded. Physical containers, food measurements, distinct-food count and purchase quantity are independent. Deferred checks reject overrides for combined/unknown formats. Prices, immutable snapshots and publication locks remain. Legacy per_pack/per_set identifiers remain. Migration 000021 permits descriptive listing selling units, not behavior identifiers. See docs/23-service-package-configuration.md." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;align=left;spacing=15;fontSize=16;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="1370" height="150" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="service-package-configuration" name="08 Service Package Configuration"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="sc-family" value="PRODUCT_FAMILIES / Add-on Service&lt;br&gt;id PK&lt;br&gt;package_format? separate_servings / combined_contents&lt;br&gt;default_presentation_quantity? positive integer&lt;br&gt;default_presentation_unit_id? FK, indexed&lt;br&gt;All null: legacy / not configured&lt;br&gt;Otherwise complete pair, package-selling context only&lt;br&gt;Combined contents: exactly one complete container" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=15;fontSize=16;fillColor=#eff6ff;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="620" height="280" as="geometry"/></mxCell>
<mxCell id="sc-unit" value="MEASUREMENT_UNITS&lt;br&gt;id PK; name; abbreviation; active&lt;br&gt;Restrictive deletion&lt;br&gt;Active references validated by Laravel" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=15;fontSize=16;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="960" y="100" width="450" height="180" as="geometry"/></mxCell>
<mxCell id="sc-edge" value="default_presentation_unit_id" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmany;endArrow=ERone;" edge="1" parent="1" source="sc-family" target="sc-unit"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="sc-version" value="PACKAGE_VERSIONS (existing)&lt;br&gt;Resolved package_format and presentation fields retained&lt;br&gt;Published snapshots remain immutable&lt;br&gt;Service-owned format must match service&lt;br&gt;Recorded default container cannot be changed&lt;br&gt;Legacy mixed-format publications and clones unchanged" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=15;fontSize=16;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="620" height="220" as="geometry"/></mxCell>
