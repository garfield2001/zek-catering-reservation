<mxCell id="rc-reservation" value="&lt;b&gt;RESERVATIONS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;id PK&lt;br/&gt;quotation_id UNIQUE FK&lt;br/&gt;confirmed quotation Version FK&lt;br/&gt;current event/capacity snapshots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="360" height="220" as="geometry"/></mxCell>
