<mxCell id="cr-request" value="&lt;b&gt;CANCELLATION_REQUESTS&lt;/b&gt;&lt;br/&gt;id PK; quotation_id FK; reservation_request_id? FK; reservation_id? FK&lt;br/&gt;idempotency_key UUID UNIQUE; kind withdrawal/cancellation&lt;br/&gt;status; reason; private internal_note?&lt;br/&gt;policy/reservation/financial JSON snapshots&lt;br/&gt;customer/business flags; requester/reviewer/finalizer facts&lt;br/&gt;one active case per quotation; ownership guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#be123c;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="570" height="350" as="geometry"/></mxCell>
<mxCell id="cr-reservation" value="&lt;b&gt;RESERVATIONS&lt;/b&gt;&lt;br/&gt;existing confirmation facts&lt;br/&gt;status confirmed/completed/cancelled&lt;br/&gt;cancelled_by?; cancelled_at?; cancellation_note?&lt;br/&gt;Only finalized cancellation moves confirmed to cancelled.&lt;br/&gt;Capacity counts confirmed rows only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="900" y="80" width="500" height="250" as="geometry"/></mxCell>
<mxCell id="cr-events" value="&lt;b&gt;CANCELLATION_REQUEST_EVENTS&lt;/b&gt;&lt;br/&gt;cancellation_request_id FK&lt;br/&gt;from/to status; note?; actor?; timestamp&lt;br/&gt;APPEND ONLY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="430" height="190" as="geometry"/></mxCell>
<mxCell id="cr-refund" value="&lt;b&gt;REFUNDS&lt;/b&gt;&lt;br/&gt;id PK; cancellation_request_id FK; payment_id FK&lt;br/&gt;idempotency_key UUID UNIQUE; positive amount_minor&lt;br/&gt;pending/approved/rejected/completed; private evidence?&lt;br/&gt;review/completion facts&lt;br/&gt;payment must belong to cancellation quotation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="690" y="520" width="530" height="270" as="geometry"/></mxCell>
<mxCell id="cr-correction" value="&lt;b&gt;REFUND_CORRECTIONS&lt;/b&gt;&lt;br/&gt;refund_id FK; signed non-zero amount_minor&lt;br/&gt;reason; recorded_by; timestamp&lt;br/&gt;APPEND ONLY; no negative net refund&lt;br/&gt;positive correction limited to money held" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1350" y="560" width="380" height="210" as="geometry"/></mxCell>
<mxCell id="cr-payment" value="&lt;b&gt;PAYMENTS&lt;/b&gt;&lt;br/&gt;existing verified payment facts remain immutable&lt;br/&gt;pending/approved refund amounts reserve a payment share&lt;br/&gt;completed refunds + corrections determine money held" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="900" y="890" width="600" height="150" as="geometry"/></mxCell>
<mxCell id="cr-e1" value="reservation_id?" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmany;endArrow=ERone;" edge="1" parent="1" source="cr-request" target="cr-reservation"><mxGeometry relative="1" as="geometry"/></mxCell>
